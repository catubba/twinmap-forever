{
  "name": "twinmap",
  "version": "0.0.0",
  "description": "Live map of World of Warcraft: Forever for your second screen",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Twinmap contributors",
  "homepage": "https://twinmap.app",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/mac-build.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "predist:mac": "node scripts/mac-build.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac dir --arm64 --publish never",
    "postdist:mac": "node scripts/mac-build.cjs sign",
    "probe:mac": "node scripts/mac-build.cjs && electron scripts/capture-mac.cjs"
  },
  "build": {
    "appId": "app.twinmap",
    "productName": "Twinmap",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/nav",
        "to": "nav"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "category": "public.app-category.games",
      "minimumSystemVersion": "14.0",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Twinmap reads the addon's pixel strip from the World of Warcraft window."
      },
      "identity": null,
      "notarize": false,
      "extraFiles": [
        {
          "from": "dist-native/twinmap-capture",
          "to": "Helpers/twinmap-capture"
        }
      ],
      "extraResources": [
        {
          "from": "build/app-update-mac.yml",
          "to": "app-update.yml"
        }
      ]
    },
    "nsis": {
      "artifactName": "Twinmap-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "catubba",
      "repo": "twinmap-forever"
    }
  },
  "devDependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/forum": "^5.3.0",
    "@fontsource/sofia-sans-semi-condensed": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dockview-core": "^8.9.1",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.6.2",
    "three": "^0.187.0"
  }
}
